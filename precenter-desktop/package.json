{
  "name": "disciples-precenter",
  "productName": "Disciples PreCenter",
  "version": "1.0.0",
  "description": "Disciples: PreCenter, the church presentation software, as a Windows desktop app",
  "main": "main.js",
  "author": "Disciples",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.disciples.precenter",
    "productName": "Disciples PreCenter",
    "copyright": "Disciples",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "ndi/**",
      "config/**",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config/config.default.json",
        "to": "config.default.json"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "publish": null,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Disciples-PreCenter-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Disciples PreCenter",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Disciples-PreCenter-Portable-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "dscservice",
        "name": "PreCenter service",
        "description": "Disciples PreCenter service file",
        "icon": "build/icon.ico",
        "role": "Editor"
      },
      {
        "ext": "dscitems",
        "name": "PreCenter items",
        "description": "Disciples PreCenter items file",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ]
  }
}
