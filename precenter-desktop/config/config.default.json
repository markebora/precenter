{
  // Disciples PreCenter settings. Edit this file, save it, then restart the app.
  // Lines that start with // are notes and are ignored. To restore every default,
  // delete this file and start the app again: a fresh copy is written for you.

  // "local"  = run the copy of PreCenter that is inside this app (works offline).
  // "remote" = load the address in "startUrl" instead (for example your hosted copy).
  "mode": "remote",
  "startUrl": "https://precenter-bay.vercel.app",

  // Your Disciples site. PreCenter asks it for the sign-in settings.
  "siteUrl": "https://worship-chords-rho.vercel.app",

  "window": {
    "width": 1500,
    "height": 900,
    "maximized": true,
    "customTitleBar": true,    // true = slim app title strip with its own minimize / maximize / close; false = normal Windows title bar
    "menuBar": false,          // true shows File / View / Help all the time (otherwise press Alt)
    "backgroundColor": "#0e0f13"
  },

  // What PreCenter may ask this computer for. false = always refused.
  "permissions": {
    "media": true,                       // camera and microphone
    "midi": true,                        // MIDI controllers
    "midiSysex": false,
    "clipboard-read": true,              // pasting pictures into the slide editor
    "clipboard-sanitized-write": true,
    "window-management": true,           // placing the Audience and Stage windows on the right screens
    "fullscreen": true,
    "display-capture": true,             // sharing a screen or window
    "notifications": false,
    "geolocation": false
  },

  // Web addresses that PreCenter may call even though the app runs from its own address.
  // Needed so sign-in and the web tools work. Add a host here only if a feature says it is blocked.
  "corsRelaxHosts": [
    "worship-chords-rho.vercel.app",
    "bible-api.com",
    "api.planningcenteronline.com"
  ],

  // Links that leave the app: "browser" opens them in your normal browser, "block" ignores them.
  "externalLinks": "browser",

  // true = use the built-in copy of JSZip so saving a service works with no internet.
  "offlineLibraries": true,

  // true = opening the app a second time just brings the first window forward.
  "singleInstance": true,

  // true = allow the developer tools (F12). Leave false for church use.
  "devTools": false,

  // NDI video output. Needs the NDI add-on described in README.md. Off by default.
  "ndi": { "enabled": false }
}
